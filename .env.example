# ===========================================
# RepoRadar Environment Variables
# ===========================================
# Copy this file to .env.local and fill in values

# Database (SQLite - no setup needed for local dev)
DATABASE_URL="file:./dev.db"

# GitHub API (optional - works without it, but rate-limited)
# Get a token at: https://github.com/settings/tokens
# Required scopes: public_repo (read-only)
GITHUB_TOKEN=""

# Ollama AI (optional - app works without it)
# Install from: https://ollama.ai
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
